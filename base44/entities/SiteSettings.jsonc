{
  "name": "SiteSettings",
  "type": "object",
  "properties": {
    "brand_name": {
      "type": "string",
      "default": "ClipLens",
      "description": "Brand name shown next to the logo mark."
    },
    "logo_image_url": {
      "type": "string",
      "description": "Optional logo image that replaces the default mark."
    },
    "accent_color": {
      "type": "string",
      "default": "#FF0000",
      "description": "Accent color (hex) applied across the whole site."
    },
    "hero_image_url": {
      "type": "string",
      "description": "Main hero visual image."
    },
    "tool_analyze_image_url": {
      "type": "string",
      "description": "Image used on the Analyze tool card."
    },
    "tool_review_image_url": {
      "type": "string",
      "description": "Image used on the Review tool card."
    },
    "before_image_url": {
      "type": "string",
      "description": "Image used in the before/after preview."
    },
    "after_image_url": {
      "type": "string",
      "description": "Image used in the before/after preview."
    },
    "gallery_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Representative thumbnails shown in the gallery section."
    },
    "particles_style": {
      "type": "string",
      "enum": [
        "dots",
        "youtube",
        "like",
        "views",
        "mixed",
        "custom"
      ],
      "default": "dots",
      "description": "Shape of the ambient background particles: dots, YouTube logo, like, views, a mix of all, or a custom image."
    },
    "particles_image_url": {
      "type": "string",
      "description": "Custom particle image used when particles_style is custom."
    },
    "texts": {
      "type": "object",
      "description": "Admin overrides for any text on the site, keyed as \"<lang>.<i18n key>\" (e.g. \"en.hero.title\")."
    },
    "credits_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master switch for the credit & subscription system. Off = the site stays completely free and open, exactly as before."
    },
    "credits_cost": {
      "type": "number",
      "default": 1,
      "description": "Credits spent per analysis when the credit system is enabled."
    },
    "credits_signup": {
      "type": "number",
      "default": 3,
      "description": "Free credits granted to a user on their first analysis when the credit system is enabled."
    },
    "credits_pro_price": {
      "type": "number",
      "default": 12,
      "description": "Monthly price of the Pro plan."
    },
    "credits_pro_amount": {
      "type": "number",
      "default": 200,
      "description": "Credits granted monthly with the Pro plan."
    }
  },
  "required": [],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}