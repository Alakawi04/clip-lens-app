{
  "name": "CreditAccount",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user id \u2014 one credit account per user."
    },
    "balance": {
      "type": "number",
      "default": 0,
      "description": "Current credit balance."
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "pro"
      ],
      "default": "free",
      "description": "Subscription plan of the account owner."
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "change": {
            "type": "number",
            "description": "Positive for grants, negative for spends."
          },
          "reason": {
            "type": "string",
            "description": "Why the balance changed: signup, analysis, pro_upgrade, admin_grant."
          },
          "date": {
            "type": "string",
            "description": "ISO date of the change."
          }
        }
      },
      "description": "Recent balance changes (last ~50)."
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}